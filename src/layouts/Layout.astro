---
import "../styles/global.css";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://www.avsaadasi.net"); // alan adını astro.config.mjs içinde `site` olarak tanımla
const ogImage = new URL(image ?? "/img/hero.webp", canonical).href; // og:image mutlak URL olmalı

// Sadece kullanılan ağırlıklar yüklenir
const FONTS =
  "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap";
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f74a6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="avsaadasi.net" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <!-- Google Analytics 4: rıza (Kabul Et) verilmeden yüklenmez ve çerez bırakmaz -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });

      var GA_ID = 'G-RQ00XZBR2W';
      function loadGA() {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        gtag('consent', 'update', { analytics_storage: 'granted' });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', GA_ID);
      }
      try { if (localStorage.getItem('avsa_cerez') === 'kabul') loadGA(); } catch (e) {}
    </script>
  </head>
  <body class="bg-kum-50 font-sans text-slate-700 antialiased">
    <slot />
    <ChatWidget />

    <!-- Çerez bilgilendirme çubuğu (KVKK): seçim yapılana kadar görünür, GA4 yalnızca "Kabul Et" ile çalışır -->
    <div id="cerez-bar" hidden role="dialog" aria-live="polite" aria-label="Çerez bilgilendirmesi" class="fixed inset-x-3 bottom-3 z-[70] mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-2xl backdrop-blur sm:bottom-5 sm:p-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <p class="flex-1 text-sm leading-relaxed text-slate-600">
          <span aria-hidden="true">🍪</span> Ziyaretçi istatistiklerini anlamak için Google Analytics çerezleri kullanıyoruz. Yalnızca onay verirsen çalışır, reddedersen çerez bırakılmaz.{" "}
          <a href="/cerez-politikasi/" class="font-semibold text-deniz-600 underline hover:text-deniz-900">Ayrıntılar</a>
        </p>
        <div class="flex shrink-0 gap-2">
          <button type="button" id="cerez-reddet" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Reddet</button>
          <button type="button" id="cerez-kabul" class="rounded-full bg-deniz-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-deniz-600">Kabul Et</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'avsa_cerez';
        var bar = document.getElementById('cerez-bar');
        var saved = null;
        try { saved = localStorage.getItem(KEY); } catch (e) {}
        if (!saved && bar) bar.hidden = false;

        function choose(v) {
          try { localStorage.setItem(KEY, v); } catch (e) {}
          if (bar) bar.hidden = true;
          if (v === 'kabul') loadGA();
        }
        var k = document.getElementById('cerez-kabul'), r = document.getElementById('cerez-reddet');
        if (k) k.addEventListener('click', function () { choose('kabul'); });
        if (r) r.addEventListener('click', function () { choose('red'); });

        // Çerez politikası sayfasındaki "tercihi değiştir" düğmesi
        document.addEventListener('click', function (e) {
          var t = e.target && e.target.closest ? e.target.closest('[data-cerez-sifirla]') : null;
          if (!t) return;
          try { localStorage.removeItem(KEY); } catch (err) {}
          if (bar) bar.hidden = false;
        });

        // GA4 olay takibi: yalnızca rıza verildiyse WhatsApp ve telefon tıklamalarını gönder
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || !window.__gaLoaded) return;
          var href = (a.getAttribute('href') || '').toLowerCase();
          if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
            gtag('event', 'whatsapp_click');
          } else if (href.indexOf('tel:') === 0) {
            gtag('event', 'phone_click');
          }
        });
      })();
    </script>
  </body>
</html>
