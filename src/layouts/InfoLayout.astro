---
// Plajlar, gezilecek yerler, feribot gibi bilgi sayfalarının ortak iskeleti:
// üst bar, kırıntı yolu, içindekiler, SSS, ilgili rehberler, alt bilgi ve JSON-LD (BreadcrumbList, Article, FAQPage).
import Layout from "./Layout.astro";
import Logo from "../components/Logo.astro";
import Header from "../components/Header.astro";
import { rehberPages } from "../data/rehber";
import { INSTAGRAM } from "../data/site";

interface Props {
  title: string; // <title>
  description: string; // meta description (<=155 karakter)
  h1: string;
  intro: string;
  crumb: string; // kırıntı yolundaki son öğe
  toc?: { id: string; label: string }[];
  faq?: { q: string; a: string }[];
  updated?: string; // "24 Ekim 2026"
  published?: string; // ISO tarih
  image?: string;
  extraLd?: object[]; // sayfaya özel ek JSON-LD (ItemList, TouristAttraction vb.)
}
const { title, description, h1, intro, crumb, toc = [], faq = [], updated, published = "2026-10-24", image, extraLd = [] } = Astro.props;
const AYLAR = ["Ocak","Şubat","Mart","Nisan","Mayıs","Haziran","Temmuz","Ağustos","Eylül","Ekim","Kasım","Aralık"];
function isoTarih(t?: string): string | undefined {
  const m = t?.match(/^(\d{1,2}) (\S+) (\d{4})$/);
  const ay = m ? AYLAR.indexOf(m[2]) : -1;
  return m && ay >= 0 ? `${m[3]}-${String(ay + 1).padStart(2, "0")}-${m[1].padStart(2, "0")}` : undefined;
}
const modified = isoTarih(updated) ?? published;
const origin = Astro.site ?? new URL("https://www.avsaadasi.net");
const url = new URL(Astro.url.pathname, origin).href;
const here = Astro.url.pathname.replace(/\/$/, "");
const others = rehberPages.filter((p) => p.path !== here);

const jsonLd: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ana sayfa", item: new URL("/", origin).href },
      { "@type": "ListItem", position: 2, name: crumb, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: h1,
    description,
    inLanguage: "tr",
    datePublished: published,
    dateModified: modified,
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: "avsaadasi.net" },
    publisher: { "@type": "Organization", name: "avsaadasi.net", url: origin.href },
    ...(image ? { image: new URL(image, origin).href } : {}),
  },
];
jsonLd.push(...extraLd);
if (faq.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
---

<Layout title={title} description={description} image={image}>
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

  <Header />

  <main>
    <section class="bg-gradient-to-br from-deniz-900 to-deniz-600 py-12 text-white md:py-16">
      <div class="mx-auto max-w-4xl px-5">
        <nav aria-label="Sayfa yolu" class="text-sm text-white/80"><a href="/" class="hover:underline">Ana sayfa</a> <span aria-hidden="true">/</span> {crumb}</nav>
        <h1 class="font-display mt-4 text-3xl font-bold leading-tight md:text-5xl">{h1}</h1>
        <p class="mt-4 max-w-2xl text-lg text-white/90">{intro}</p>
        {updated && <p class="mt-4 text-sm text-white/75">Son kontrol: {updated}</p>}
      </div>
    </section>

    <article class="mx-auto max-w-4xl px-5 pb-6 pt-10">
      {toc.length > 0 && (
        <nav aria-label="İçindekiler" class="rounded-2xl border border-slate-200 bg-white p-5">
          <p class="font-semibold text-deniz-900">İçindekiler</p>
          <ol class="mt-2 list-decimal space-y-1 pl-5 text-deniz-600">
            {toc.map((t) => <li><a href={`#${t.id}`} class="hover:underline">{t.label}</a></li>)}
          </ol>
        </nav>
      )}

      <div class="[&_h2]:mt-12 [&_h2]:scroll-mt-24 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-deniz-900 md:[&_h2]:text-3xl [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-deniz-900 [&_p]:mt-4 [&_p]:leading-relaxed [&_table]:mt-4 [&_table]:w-full [&_table]:text-sm [&_th]:bg-deniz-900 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:text-white [&_td]:border-b [&_td]:border-slate-200 [&_td]:px-3 [&_td]:py-2 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6 [&_a:not([class])]:text-deniz-600 [&_a:not([class])]:underline">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="mt-12">
          <h2 id="sss" class="scroll-mt-24 font-display text-2xl font-bold text-deniz-900 md:text-3xl">Sık sorulan sorular</h2>
          <div class="mt-5 space-y-3">
            {faq.map((f) => (
              <details class="group rounded-2xl border border-slate-200 bg-white p-5">
                <summary class="cursor-pointer list-none font-semibold text-deniz-900 marker:hidden">{f.q}</summary>
                <p class="mt-3 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="mt-12" aria-labelledby="diger-rehberler">
        <h2 id="diger-rehberler" class="font-display text-2xl font-bold text-deniz-900">Diğer Avşa rehberleri</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {others.map((p) => (
            <li>
              <a href={p.path} class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-deniz-500 hover:shadow">
                <span class="text-2xl" aria-hidden="true">{p.icon}</span>
                <span><span class="block font-semibold text-deniz-900">{p.label}</span><span class="text-sm text-slate-500">{p.short}</span></span>
              </a>
            </li>
          ))}
          <li>
            <a href="/avsa-adasi-tarihi-ve-plajlari/" class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-deniz-500 hover:shadow">
              <span class="text-2xl" aria-hidden="true">📜</span>
              <span><span class="block font-semibold text-deniz-900">Tarihi ve plajları</span><span class="text-sm text-slate-500">Adanın tarihi ve koyların hikâyesi</span></span>
            </a>
          </li>
        </ul>
      </section>

      <div class="mt-12 rounded-3xl bg-gradient-to-br from-deniz-600 to-deniz-900 p-8 text-center text-white">
        <p class="font-display text-2xl font-bold">Avşa'da nerede kalacağını seç</p>
        <p class="mt-2 text-white">Otel, pansiyon ve apart seçeneklerini işletmeyle doğrudan konuşarak ayır.</p>
        <a href="/#konaklama" class="mt-5 inline-block rounded-full bg-white px-7 py-3 font-semibold text-deniz-900 transition hover:scale-105">Konaklamaları gör</a>
      </div>
    </article>
  </main>

  <footer class="mt-8 border-t border-kum-100 bg-white py-8 text-center text-sm text-slate-500">
    <nav aria-label="Rehberler" class="mb-3 flex flex-wrap justify-center gap-x-5 gap-y-1">
      {rehberPages.map((p) => <a href={p.path} class="hover:text-deniz-600">{p.label}</a>)}
      <a href="/kiralik-evler/" class="hover:text-deniz-600">Kiralık Evler</a>
      <a href="/iletisim/" class="hover:text-deniz-600">İletişim</a>
      <a href="/cerez-politikasi/" class="hover:text-deniz-600">Çerez Politikası</a>
    </nav>
    <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="mb-2 inline-block font-semibold text-deniz-900 hover:text-pink-600">Instagram: @avsaadasi</a><br />
    © {new Date().getFullYear()} avsaadasi.net. Tüm hakları saklıdır.
  </footer>
</Layout>
