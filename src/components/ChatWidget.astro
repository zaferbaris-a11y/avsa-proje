---
import { WHATSAPP } from "../data/site";

interface Props {
  whatsapp?: string;
}
const { whatsapp = WHATSAPP } = Astro.props;

const suggestions = [
  "Çocuklu aile için ne önerirsin?",
  "En uygun fiyatlı pansiyon hangisi?",
  "Mutfaklı apart var mı?",
  "Denize en yakın otel hangisi?",
];
---

<div id="chat-root" data-wa={whatsapp} class="fixed bottom-5 right-5 z-[60] font-sans">
  <!-- Panel -->
  <section
    id="chat-panel"
    hidden
    class="mb-3 flex h-[32rem] max-h-[75vh] w-[calc(100vw-2.5rem)] max-w-sm flex-col overflow-hidden rounded-3xl border border-kum-100 bg-white shadow-2xl"
    aria-label="Avşa asistanı"
  >
    <header class="flex items-center justify-between bg-gradient-to-r from-deniz-600 to-deniz-900 px-5 py-4 text-white">
      <div>
        <p class="font-display text-lg font-bold leading-tight">Avşa Asistanı</p>
        <p class="text-xs text-white">Otel, pansiyon ve apart sorularını yanıtlar</p>
      </div>
      <button id="chat-close" class="rounded-full p-1 text-xl leading-none hover:bg-white/20" aria-label="Kapat">×</button>
    </header>

    <div id="chat-messages" class="flex-1 space-y-3 overflow-y-auto bg-kum-50 px-4 py-4 text-sm" aria-live="polite"></div>

    <div id="chat-suggestions" class="flex flex-wrap gap-2 border-t border-kum-100 bg-white px-4 py-3">
      {suggestions.map((s) => (
        <button type="button" class="chat-suggest rounded-full border border-deniz-100 bg-deniz-50 px-3 py-1.5 text-xs font-medium text-deniz-600 hover:bg-deniz-100">
          {s}
        </button>
      ))}
    </div>

    <form id="chat-form" class="flex gap-2 border-t border-kum-100 bg-white p-3">
      <input
        id="chat-input"
        type="text"
        maxlength="500"
        autocomplete="off"
        placeholder="Sorunu yaz..."
        class="min-w-0 flex-1 rounded-full border border-slate-200 px-4 py-2 text-sm outline-none focus:border-deniz-500"
      />
      <button id="chat-send" type="submit" class="rounded-full bg-gunbatimi px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">
        Gönder
      </button>
    </form>
  </section>

  <!-- Açma düğmesi -->
  <button
    id="chat-toggle"
    class="ml-auto flex h-14 w-14 items-center justify-center rounded-full bg-gunbatimi text-2xl text-white shadow-lg shadow-gunbatimi/40 transition hover:scale-105"
    aria-label="Sohbeti aç"
  >
    💬
  </button>
</div>

<script>
  type Msg = { role: "user" | "assistant"; content: string };

  const root = document.getElementById("chat-root") as HTMLElement;
  const panel = document.getElementById("chat-panel") as HTMLElement;
  const toggle = document.getElementById("chat-toggle") as HTMLButtonElement;
  const closeBtn = document.getElementById("chat-close") as HTMLButtonElement;
  const list = document.getElementById("chat-messages") as HTMLElement;
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const send = document.getElementById("chat-send") as HTMLButtonElement;
  const suggestBox = document.getElementById("chat-suggestions") as HTMLElement;
  const wa = root.dataset.wa ?? "";

  const history: Msg[] = [];
  let busy = false;

  // Metni güvenli şekilde yaz (HTML olarak değil); link ve sayfa yollarını tıklanabilir yap
  function renderText(el: HTMLElement, text: string) {
    const parts = text.split(/(https?:\/\/[^\s)]+|\/konaklama\/[a-z0-9-]+)/g);
    parts.forEach((part) => {
      if (/^(https?:\/\/|\/konaklama\/)/.test(part)) {
        const a = document.createElement("a");
        a.href = part;
        a.textContent = part.startsWith("https://wa.me/") ? "WhatsApp'tan yaz" : part;
        a.className = "font-medium text-deniz-600 underline";
        if (part.startsWith("http")) {
          a.target = "_blank";
          a.rel = "noopener noreferrer";
        }
        el.appendChild(a);
      } else {
        el.appendChild(document.createTextNode(part));
      }
    });
  }

  function addMessage(role: "user" | "assistant", text: string): HTMLElement {
    const wrap = document.createElement("div");
    wrap.className = role === "user" ? "flex justify-end" : "flex justify-start";
    const bubble = document.createElement("div");
    bubble.className =
      role === "user"
        ? "max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-br-sm bg-deniz-600 px-4 py-2 text-white"
        : "max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-bl-sm bg-white px-4 py-2 text-slate-700 shadow-sm";
    renderText(bubble, text);
    wrap.appendChild(bubble);
    list.appendChild(wrap);
    list.scrollTop = list.scrollHeight;
    return bubble;
  }

  function open() {
    panel.hidden = false;
    toggle.hidden = true;
    if (list.childElementCount === 0) {
      addMessage("assistant", "Merhaba! Avşa'daki otel, pansiyon ve apartlar hakkında sorularını yanıtlayabilirim. Ne arıyorsun?");
    }
    input.focus();
  }
  function close() {
    panel.hidden = true;
    toggle.hidden = false;
  }

  async function ask(text: string) {
    if (busy || !text.trim()) return;
    busy = true;
    send.disabled = true;
    suggestBox.hidden = true;

    addMessage("user", text);
    history.push({ role: "user", content: text });
    input.value = "";

    const pending = addMessage("assistant", "Yazıyor…");
    pending.classList.add("text-slate-500");

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });
      const data = await res.json();
      pending.textContent = "";
      pending.classList.remove("text-slate-500");

      if (!res.ok || !data.reply) {
        renderText(pending, `${data.error ?? "Bir sorun oluştu."} İstersen doğrudan WhatsApp'tan yazabilirsin: https://wa.me/${wa}`);
      } else {
        renderText(pending, data.reply);
        history.push({ role: "assistant", content: data.reply });
      }
    } catch {
      pending.textContent = "";
      pending.classList.remove("text-slate-500");
      renderText(pending, `Bağlantı kurulamadı. WhatsApp'tan yazabilirsin: https://wa.me/${wa}`);
    } finally {
      busy = false;
      send.disabled = false;
      list.scrollTop = list.scrollHeight;
      input.focus();
    }
  }

  toggle.addEventListener("click", open);
  closeBtn.addEventListener("click", close);
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    ask(input.value);
  });
  document.querySelectorAll<HTMLButtonElement>(".chat-suggest").forEach((b) => {
    b.addEventListener("click", () => ask(b.textContent ?? ""));
  });
</script>
