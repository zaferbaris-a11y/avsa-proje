---
// Site üst menüsü: masaüstünde "Konaklama" açılır menüsü (hover/focus/tık), mobilde hamburger + akordeon.
import Logo from "./Logo.astro";
import { WHATSAPP, INSTAGRAM } from "../data/site";

const gruplar = [
  {
    id: "konaklama",
    label: "Konaklama",
    items: [
      { href: "/avsa-otelleri/", label: "Avşa Otelleri", icon: "🏨" },
      { href: "/avsa-pansiyonlari/", label: "Avşa Pansiyonları", icon: "🏡" },
      { href: "/avsa-apartlari/", label: "Avşa Apartları", icon: "🏢" },
      { href: "/kiralik-evler/", label: "Avşa Kiralık Evler", icon: "🔑" },
    ],
  },
  {
    id: "rehber",
    label: "Rehber",
    items: [
      { href: "/avsa-adasi/", label: "Avşa Adası Rehberi", icon: "📍" },
      { href: "/plajlar/", label: "Avşa Plajları ve Koyları", icon: "🏖️" },
      { href: "/gezilecek-yerler/", label: "Avşa Gezilecek Yerler", icon: "🧭" },
      { href: "/gece-hayati/", label: "Avşa Gece Hayatı", icon: "🌙" },
      { href: "/avsada-ne-yenir/", label: "Avşa'da Ne Yenir?", icon: "🐟" },
    ],
  },
  {
    id: "ulasim",
    label: "Ulaşım",
    items: [
      { href: "/avsa-adasina-nasil-gidilir/", label: "Avşa'ya Nasıl Gidilir?", icon: "🚗" },
      { href: "/feribot-saatleri/", label: "Avşa Feribot Saatleri", icon: "⛴️" },
      { href: "/bilet-fiyatlari/", label: "Avşa Bilet Fiyatları", icon: "🎟️" },
    ],
  },
];
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/95 backdrop-blur" data-header>
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3" aria-label="Ana menü">
    <a href="/" aria-label="avsaadasi.net ana sayfa" class="shrink-0"><Logo /></a>

    <!-- Masaüstü menü -->
    <ul class="hidden items-center gap-6 xl:gap-7 whitespace-nowrap text-sm font-medium text-slate-700 lg:flex">
      <li><a class="py-2 hover:text-deniz-600" href="/">Ana Sayfa</a></li>
      {gruplar.map((g) => (
      <li class="group relative" data-dropdown>
        <button type="button" data-dropdown-btn aria-haspopup="true" aria-expanded="false" class="flex items-center gap-1 rounded-lg py-2 hover:text-deniz-600 focus-visible:outline-2 focus-visible:outline-deniz-600">
          {g.label}
          <svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 group-data-[open=true]:rotate-180" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
        </button>
        <div class="invisible absolute left-1/2 top-full z-50 w-60 -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-data-[open=true]:visible group-data-[open=true]:translate-y-0 group-data-[open=true]:opacity-100">
          <ul class="overflow-hidden rounded-2xl border border-slate-100 bg-white p-2 shadow-xl ring-1 ring-black/5" role="menu">
            {g.items.map((k) => (
              <li role="none">
                <a href={k.href} role="menuitem" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-slate-700 transition hover:bg-deniz-600/10 hover:text-deniz-900">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-50 text-base" aria-hidden="true">{k.icon}</span>
                  <span class="font-semibold">{k.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
      ))}
      <li><a class="py-2 hover:text-deniz-600" href="/iletisim/">İletişim</a></li>
    </ul>

    <div class="flex items-center gap-2">
      <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label="Instagram: @avsaadasi" title="Instagram: @avsaadasi" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-deniz-900 transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-600">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href={`https://wa.me/${WHATSAPP}`} class="hidden rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-deniz-900 hover:bg-slate-50 sm:inline-block">WhatsApp</a>
      <a href="/iletisim/" class="hidden whitespace-nowrap rounded-full bg-deniz-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-deniz-600 sm:inline-block">İşletmeni ekle</a>
      <!-- Hamburger -->
      <button type="button" data-menu-btn aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobil-menu" class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-deniz-900 lg:hidden">
        <svg data-icon-open viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg data-icon-close viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobil menü -->
  <div id="mobil-menu" data-menu hidden class="border-t border-slate-100 bg-white lg:hidden">
    <ul class="mx-auto max-w-6xl space-y-1 px-5 py-4 text-base font-medium text-slate-800">
      <li><a href="/" class="block rounded-xl px-3 py-3 hover:bg-slate-50">Ana Sayfa</a></li>
      {gruplar.map((g) => (
      <li>
        <button type="button" data-acc-btn aria-expanded="false" aria-controls={`mobil-${g.id}`} class="flex w-full items-center justify-between rounded-xl px-3 py-3 text-left hover:bg-slate-50">
          {g.label}
          <svg data-acc-icon viewBox="0 0 20 20" class="h-5 w-5 transition-transform duration-200" fill="currentColor" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5z"/></svg>
        </button>
        <ul id={`mobil-${g.id}`} hidden class="mt-1 space-y-1 rounded-2xl bg-slate-50 p-2">
          {g.items.map((k) => (
            <li>
              <a href={k.href} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-white">
                <span aria-hidden="true">{k.icon}</span><span>{k.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </li>
      ))}
      <li><a href="/iletisim/" class="block rounded-xl px-3 py-3 hover:bg-slate-50">İletişim</a></li>
      <li class="grid grid-cols-2 gap-2 pt-3">
        <a href={`https://wa.me/${WHATSAPP}`} class="rounded-full border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-deniz-900">WhatsApp</a>
        <a href="/iletisim/" class="rounded-full bg-deniz-900 px-4 py-3 text-center text-sm font-semibold text-white">İşletmeni ekle</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    // Hamburger
    const btn = header.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
    const menu = header.querySelector<HTMLElement>("[data-menu]")!;
    const iconOpen = header.querySelector<HTMLElement>("[data-icon-open]")!;
    const iconClose = header.querySelector<HTMLElement>("[data-icon-close]")!;
    const setMenu = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Menüyü kapat" : "Menüyü aç");
      iconOpen.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
    };
    btn.addEventListener("click", () => setMenu(menu.hidden));

    // Mobil akordeonlar
    header.querySelectorAll<HTMLButtonElement>("[data-acc-btn]").forEach((acc) => {
      const panel = header.querySelector<HTMLElement>("#" + acc.getAttribute("aria-controls"))!;
      const accIcon = acc.querySelector<HTMLElement>("[data-acc-icon]")!;
      acc.addEventListener("click", () => {
        const open = panel.hidden;
        panel.hidden = !open;
        acc.setAttribute("aria-expanded", String(open));
        accIcon.classList.toggle("rotate-180", open);
      });
    });

    // Mobilde bir bağlantıya tıklayınca menü kapansın
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));

    // Masaüstü açılır menüler: hover/focus + tık (dokunmatik), dışarı tık/Esc ile kapanır
    const dds = Array.from(header.querySelectorAll<HTMLElement>("[data-dropdown]"));
    const setDd = (dd: HTMLElement, open: boolean) => {
      dd.dataset.open = String(open);
      dd.querySelector("[data-dropdown-btn]")?.setAttribute("aria-expanded", String(open));
    };
    dds.forEach((dd) => {
      dd.querySelector("[data-dropdown-btn]")!.addEventListener("click", () => {
        const open = dd.dataset.open !== "true";
        dds.forEach((o) => setDd(o, false));
        setDd(dd, open);
      });
    });
    document.addEventListener("click", (e) => dds.forEach((dd) => { if (!dd.contains(e.target as Node)) setDd(dd, false); }));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { dds.forEach((dd) => setDd(dd, false)); setMenu(false); }
    });
  }
</script>
