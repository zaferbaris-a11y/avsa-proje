---
// Tıklayınca yüklenen YouTube videosu: sayfa hızını bozmaz, tıklanana kadar YouTube'a istek atmaz.
interface Props { id: string; baslik: string }
const { id, baslik } = Astro.props;
---
<figure class="my-8">
  <div class="video-kutu relative aspect-video overflow-hidden rounded-2xl bg-slate-900" data-video={id}>
    <button type="button" class="group absolute inset-0 h-full w-full" aria-label={`Videoyu oynat: ${baslik}`}>
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={baslik} width="480" height="360" loading="lazy" class="h-full w-full object-cover opacity-90 transition group-hover:opacity-100" />
      <span class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-red-600 text-3xl text-white shadow-lg" aria-hidden="true">▶</span>
    </button>
  </div>
  <figcaption class="mt-2 text-sm text-slate-500">Video: {baslik} · <a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener">YouTube'da izle</a></figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.video-kutu').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const id = box.dataset.video;
      box.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Avşa Adası Rehberi videosu" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
