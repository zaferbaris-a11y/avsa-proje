---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { WHATSAPP, INSTAGRAM } from "../data/site";

const title = "İletişim: Avşa Adası Rehberi | avsaadasi.net";
const description =
  "avsaadasi.net iletişim: Anatolia Old Town. Avşa Adası konaklama, ulaşım ve işletme ekleme için telefon, WhatsApp ve e-posta ile bize ulaşın.";

const PHONE_DISPLAY = "+66 62 471 2500";
const PHONE_TEL = "+" + WHATSAPP; // +66624712500
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
const origin = "https://www.avsaadasi.net";
const EMAIL = "zafer.baris@gmail.com";
const ADDRESS_TEXT = "64/3 Bo Phut, Koh Samui, Surat Thani, Tayland";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "İletişim",
    url: `${origin}/iletisim/`,
    inLanguage: "tr-TR",
    isPartOf: { "@id": `${origin}/#website` },
    mainEntity: {
      "@type": "Organization",
      name: "Anatolia Old Town",
      brand: { "@type": "Brand", name: "avsaadasi.net" },
      telephone: PHONE_TEL,
      email: EMAIL,
      address: { "@type": "PostalAddress", streetAddress: "64/3", addressLocality: "Bo Phut, Koh Samui", addressRegion: "Surat Thani", addressCountry: "TH" },
      sameAs: [INSTAGRAM],
      contactPoint: { "@type": "ContactPoint", contactType: "customer support", telephone: PHONE_TEL, email: EMAIL, availableLanguage: ["Turkish"], areaServed: "TR" },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ana sayfa", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "İletişim", item: `${origin}/iletisim/` },
    ],
  },
];

const topics = [
  { icon: "🏨", title: "Konaklama bilgisi", text: "Tarih ve kişi sayısını yaz, Avşa'da sana uygun otel, pansiyon veya apartı birlikte seçelim.", msg: "Merhaba, Avşa Adası'nda konaklama arıyorum. Tarih: ... Kişi sayısı: ..." },
  { icon: "⛴️", title: "Ulaşım ve feribot", text: "İstanbul, Bursa, Tekirdağ veya Erdek'ten Avşa'ya nasıl geleceğini soralım.", msg: "Merhaba, Avşa Adası'na ulaşım hakkında bilgi almak istiyorum." },
  { icon: "📣", title: "İşletmeni ekle", text: "Avşa'da işletmen varsa sayfanı hazırlayıp sitede yayınlayalım.", msg: "Merhaba, Avşa Adası'ndaki işletmemi avsaadasi.net'te yayınlatmak istiyorum." },
];
---

<Layout title={title} description={description}>
  {jsonLd.map((d) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(d)} />)}
  <Header />

  <main>
    <!-- Başlık bandı -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-deniz-900 via-deniz-600 to-deniz-500 text-white">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gunbatimi/25 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-28 -left-20 h-72 w-72 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl px-5 py-14 md:py-20">
        <nav aria-label="Sayfa yolu" class="text-sm text-white/80"><a href="/" class="hover:underline">Ana sayfa</a> <span aria-hidden="true">/</span> İletişim</nav>
        <h1 class="font-display mt-4 max-w-2xl text-4xl font-bold leading-tight md:text-5xl">Avşa tatilin için bize ulaş</h1>
        <p class="mt-4 max-w-xl text-lg text-white/90">Telefonla ya da WhatsApp'tan yaz; Avşa Adası'nda konaklama, ulaşım ve işletme ekleme konularında yardımcı olalım.</p>
      </div>
    </section>

    <!-- İletişim kartları -->
    <section class="relative z-10 mx-auto -mt-10 max-w-5xl px-5 pb-6">
      <div class="grid gap-5 md:grid-cols-2">
        <!-- WhatsApp -->
        <div class="rounded-3xl border border-emerald-100 bg-white p-7 shadow-lg">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-2xl" aria-hidden="true">💬</span>
          <h2 class="mt-4 text-xl font-bold text-deniz-900">WhatsApp</h2>
          <p class="mt-1 text-slate-600">Telefon numaramız aynı zamanda <strong class="text-deniz-900">WhatsApp numarasıdır</strong>. En hızlı yanıt için WhatsApp'tan yaz.</p>
          <p class="mt-4 text-2xl font-bold tracking-wide text-deniz-900">{PHONE_DISPLAY}</p>
          <a href={wa("Merhaba, Avşa Adası hakkında bilgi almak istiyorum.")} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-full bg-emerald-600 px-6 py-3 font-semibold text-white transition hover:bg-emerald-700">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.7-5.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>
            WhatsApp'tan yaz
          </a>
        </div>

        <!-- Telefon -->
        <div class="rounded-3xl border border-deniz-100 bg-white p-7 shadow-lg">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-deniz-50 text-2xl" aria-hidden="true">📞</span>
          <h2 class="mt-4 text-xl font-bold text-deniz-900">Telefon</h2>
          <p class="mt-1 text-slate-600">Numara bir Tayland numarasıdır (+66). Türkiye'den ararken uluslararası arama ücreti uygulanabilir; WhatsApp ile yazmak genellikle daha kolaydır.</p>
          <p class="mt-4 text-2xl font-bold tracking-wide text-deniz-900">{PHONE_DISPLAY}</p>
          <a href={`tel:${PHONE_TEL}`} class="mt-5 inline-flex items-center gap-2 rounded-full bg-deniz-900 px-6 py-3 font-semibold text-white transition hover:bg-deniz-600">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
            Ara
          </a>
        </div>
      </div>

      <!-- Şirket, e-posta, adres -->
      <div class="mt-5 rounded-3xl bg-kum-100/60 p-6">
        <div class="flex items-center gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">🏛️</span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Şirket</p>
            <p class="text-xl font-bold text-deniz-900">Anatolia Old Town</p>
          </div>
        </div>
        <dl class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-white p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">✉️ E-posta</dt>
            <dd class="mt-1 break-all font-semibold text-deniz-900"><a href={`mailto:${EMAIL}`} class="hover:text-deniz-600 hover:underline">{EMAIL}</a></dd>
          </div>
          <div class="rounded-2xl bg-white p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">📍 Adres</dt>
            <dd class="mt-1 font-semibold text-deniz-900">{ADDRESS_TEXT}</dd>
          </div>
        </dl>
        <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-deniz-900 transition hover:border-pink-500 hover:text-pink-600">Instagram: @avsaadasi</a>
      </div>
    </section>

    <!-- Konular -->
    <section class="mx-auto max-w-5xl px-5 py-10">
      <h2 class="font-display text-2xl font-bold text-deniz-900 md:text-3xl">Ne için yazabilirsin?</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {topics.map((t) => (
          <a href={wa(t.msg)} target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-1 hover:border-deniz-500 hover:shadow-lg">
            <span class="text-3xl" aria-hidden="true">{t.icon}</span>
            <h3 class="mt-3 font-bold text-deniz-900">{t.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">{t.text}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-deniz-600 group-hover:underline">WhatsApp'tan yaz →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Alt CTA -->
    <section class="px-5 pb-16">
      <div class="mx-auto max-w-5xl rounded-3xl bg-gradient-to-br from-deniz-600 to-deniz-900 p-8 text-center text-white md:p-12">
        <p class="font-display text-2xl font-bold md:text-3xl">Avşa'da nerede kalacağını seç</p>
        <p class="mx-auto mt-2 max-w-xl text-white/90">Otel, pansiyon ve apart seçeneklerini işletmeyle doğrudan konuşarak ayır.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/avsa-otelleri/" class="rounded-full bg-white px-6 py-3 font-semibold text-deniz-900 transition hover:scale-105">Avşa otelleri</a>
          <a href="/avsa-adasi/" class="rounded-full border border-white/60 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Avşa Adası rehberi</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-kum-100 bg-white py-8 text-center text-sm text-slate-500">
    <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="mb-2 inline-block font-semibold text-deniz-900 hover:text-pink-600">Instagram: @avsaadasi</a><br />
    <a href="/cerez-politikasi/" class="hover:text-deniz-600">Çerez Politikası</a><br />
    © {new Date().getFullYear()} avsaadasi.net · Anatolia Old Town. Tüm hakları saklıdır.
  </footer>
</Layout>
