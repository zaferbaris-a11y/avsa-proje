---
import InfoLayout from "../layouts/InfoLayout.astro";
import StayLinks from "../components/StayLinks.astro";
import { stays } from "../data/stays";

const title = "Avşa Adası Plajları: Koy Koy Rehber (2026) | avsaadasi.net";
const description =
  "Avşa Adası plajları: Altınkum, Çınar Koyu, Mavi Koy, Karadut, Kadınlar Plajı ve Kumtur. Hangi koy kime uygun, nasıl gidilir, Avşa'da nerede kalınır?";

const galeri = [
  { src: "/img/plajlar/cinar-koyu-sezlong-sahil-1.webp", w: 640, h: 425, alt: "Çınar Koyu Avşa, berrak deniz ve sahil boyunca şezlonglar", cap: "Çınar Koyu" },
  { src: "/img/plajlar/kadinlar-plaji-koy-1.webp", w: 640, h: 480, alt: "Kadınlar Plajı Avşa, kumsal ve koy manzarası", cap: "Kadınlar Plajı" },
  { src: "/img/plajlar/karadut-plaji-sezlong-1.webp", w: 640, h: 480, alt: "Karadut Plajı Avşa, koy kıyısında şezlonglar", cap: "Karadut" },
  { src: "/img/plajlar/tavsanli-koyu-plaj-1.webp", w: 445, h: 355, alt: "Tavşanlı Koyu Avşa Adası, hasır şemsiyeler ve sahil", cap: "Tavşanlı Koyu" },
  { src: "/img/plajlar/yigitler-plaji-hasir-semsiye-1.webp", w: 445, h: 355, alt: "Yiğitler plajı Avşa, hasır şemsiyeler ve sahil", cap: "Yiğitler plajı" },
];

const toc = [
  { id: "genel-bakis", label: "Avşa plajlarına genel bakış" },
  { id: "koylar", label: "Plaj ve koy rehberi" },
  { id: "aileler", label: "Çocuklu aileler için plajlar" },
  { id: "plaj-kulupleri", label: "Plaj kulüpleri ve ücretsiz plajlar" },
  { id: "sakin-koylar", label: "Sakin ve kalabalıktan uzak koylar" },
  { id: "ulasim", label: "Plajlara nasıl gidilir?" },
  { id: "sezon", label: "Ne zaman gidilir?" },
  { id: "ipuclari", label: "Plaj günü için ipuçları" },
  { id: "konaklama", label: "Plaja yakın konaklama" },
];

const origin = "https://www.avsaadasi.net";
const beaches = [
  { id: "altinkum", name: "Altınkum Koyu", where: "Yiğitler Köyü yanı", time: "Merkezden minibüsle yaklaşık 10 dk", text: "Yiğitler Köyü'nün hemen yanındaki Altınkum, adanın en çok anılan koylarından biri. Üç plaj işletmesi (beach club) bulunuyor; bunların yanında ücretsiz halk plajı da var. Kalabalık bir koy olduğundan müzik, bar ve şezlong düzeniyle \"plajda canlı bir gün\" arayanlara uygun." },
  { id: "karadut", name: "Karadut Koyu", where: "Altınkum ve Yiğitler çevresi", time: "Altınkum'a yakın", text: "Uzun bir sahile sahip Karadut'ta giriş ücretsiz ve deniz sığ. İki büyük çay bahçesi var; şezlong ve şemsiye plaj restoranlarından kiralanıyor. Çocuklu aileler için sakin ve güvenli bir seçenek." },
  { id: "kadinlar", name: "Kadınlar Plajı", where: "Tavşanlı ve Altınkum çevresi", time: "Yiğitler'den yürüme mesafesi", text: "Yalnızca kadınlara ayrılmış, ücretsiz ve sığ sulu bir plaj. Plajın üzerinde kafe, işletme ya da tuvalet gibi olanaklar yok; su, atıştırmalık ve gölgelik getirmek gerekiyor. Sessiz, rahat ve serbest bir plaj günü isteyen kadınlar için." },
  { id: "cinar", name: "Çınar Koyu", where: "Adanın en geniş plajı", time: "Merkezden yaklaşık 10-15 dk", text: "Berrak deniziyle bilinen Çınar Koyu adanın en büyük plajı. Hem ücretsiz plaj alanı hem de şemsiye ve şezlongun ücretli olduğu plaj işletmeleri bulunuyor. Merkezden minibüs saatlik kalkıyor ve yaklaşık 20:00'ye kadar çalışıyor." },
  { id: "mavi-koy", name: "Mavi Koy", where: "Kuzey kıyısı", time: "Merkezden minibüsle yaklaşık 5 dk", text: "Merkeze en yakın koylardan biri. Çevresinde restoran ve kafeler sıralanıyor, şezlong ve şemsiye işletmelerden kiralanıyor. Yemek ve plaj arasında mesafe istemeyenler için kolay bir tercih." },
  { id: "merkez", name: "Merkez Sahili", where: "İskele çevresi", time: "Yürüme mesafesi", text: "Yaklaşık 3 km uzunluğundaki merkez sahilinde denize girilebiliyor. Buradan tekne kiralayıp diğer koylara geçmek de mümkün. Merkezde kalıyorsan ilk plaj durağın burası." },
  { id: "koy-sahili", name: "Köy Sahili", where: "Merkeze yakın köy kesimi", time: "Merkeze yaklaşık 1,5 km", text: "Çok ince kumlu bir sahile sahip. Köyde Rum döneminden kalma yapılar da var; plaj gününü köy gezisiyle birleştirmek için güzel bir durak." },
  { id: "manastir", name: "Manastır ve Beyazsaray Koyu", where: "Güney-batı yönü", time: "İskeleden araçla yaklaşık 5 dk (Manastır)", text: "Manastır çevresinde yüzülebiliyor. Manastır'dan sonra gelen Beyazsaray'a iniş eğimli; yürümek yerine merkezden ATV kiralayarak gitmek öneriliyor. Bir otel plajın bir bölümünü kendi misafirlerine ayırıyor, büyük kısmı ücretsiz." },
  { id: "kumtur", name: "Kumtur", where: "Adanın güney ucu", time: "Merkezden minibüsle yaklaşık 20 dk", text: "Sakin, çoğunlukla özel villalardan oluşan bir bölge; çevrede restoran ya da kafe yok. Deniz bu koyda daha derin, bu yüzden yüzme bilmeyenler ve çocuklu aileler dikkatli olmalı." },
];

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Avşa Adası plajları ve koyları",
  itemListElement: beaches.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Beach",
      "@id": `${origin}/plajlar/#${b.id}`,
      name: b.name,
      description: b.text,
      url: `${origin}/plajlar/#${b.id}`,
      isAccessibleForFree: ["karadut", "kadinlar"].includes(b.id) ? true : undefined,
      containedInPlace: { "@type": "Place", name: "Avşa Adası", address: { "@type": "PostalAddress", addressRegion: "Balıkesir", addressCountry: "TR" } },
    },
  })),
};

// Konaklama bağlantıları: veri tabanındaki "nearby" ve bölge bilgisinden gelir
const yigitler = stays.filter((s) => s.area === "Yiğitler").map((stay) => ({ stay, note: "Yiğitler Köyü, Altınkum ve Karadut'a yakın" }));
const bagl = (label: RegExp, note: string) =>
  stays.filter((s) => s.nearby.some((n) => label.test(n.label))).map((stay) => ({ stay, note }));
const merkezPlaj = bagl(/Merkez Plajı/, "Merkez sahilinde, plaja yürüyerek");
const kadinlar = bagl(/Kadınlar Plajı/, "Kadınlar Plajı'na yakın");

const faq = [
  { q: "Avşa'nın en güzel plajı hangisi?", a: "Zevke göre değişiyor: geniş ve berrak bir plaj için Çınar Koyu, sığ ve sakin deniz için Karadut ve Kadınlar Plajı, canlı bir plaj günü için Altınkum, restoran ve kafelere yakınlık için Mavi Koy tercih ediliyor." },
  { q: "Avşa plajları ücretli mi?", a: "Çoğu koyda hem ücretsiz halk plajı hem de şemsiye ve şezlongun ücretli olduğu plaj işletmeleri bulunuyor. Karadut ve Kadınlar Plajı'nda giriş ücretsiz; şezlong gerekiyorsa yakındaki işletmelerden kiralanıyor." },
  { q: "Çocuklu aileler için hangi plaj uygun?", a: "Denizi sığ olan Karadut Koyu ve Kadınlar Plajı ailelerin sık tercih ettiği yerler. Kumtur'da deniz daha derin olduğu için çocuklarla dikkatli olunmalı." },
  { q: "Avşa'da yalnızca kadınlara ait plaj var mı?", a: "Evet, Kadınlar Plajı yalnızca kadınlara ayrılmış, giriş ücretsiz. Üzerinde işletme olmadığı için su ve yiyecek getirmek gerekiyor." },
  { q: "Merkezden plajlara nasıl gidilir?", a: "Çınar Koyu, Altınkum, Mavi Koy ve Kumtur'a merkezden minibüs kalkıyor; süreler 5 ile 20 dakika arasında. Çınar Koyu hattı saatlik seferle yaklaşık 20:00'ye kadar çalışıyor. Merkezden motosiklet, tekne ve ATV kiralamak da mümkün." },
  { q: "Avşa'da plajlar ne zaman açık?", a: "Plaj işletmelerinin çoğu yaz sezonunda hizmet veriyor. Açılış ve kapanış tarihleri işletmeye göre değiştiği için gitmeden önce aramak en sağlıklısı." },
];
---

<InfoLayout
  title={title}
  description={description}
  h1="Avşa Adası Plajları ve Koyları"
  intro="Altınkum'dan Çınar Koyu'na, Kadınlar Plajı'ndan Kumtur'a: Marmara Denizi'ndeki Avşa Adası'nın plajlarının karakteri, ulaşım süreleri ve hangi koyun kime uygun olduğu."
  crumb="Plajlar"
  toc={toc}
  faq={faq}
  updated="24 Ekim 2026"
  image="/img/hero.webp"
  extraLd={[itemList]}
>
  <h2 id="genel-bakis">Avşa plajlarına genel bakış</h2>
  <p>Marmara Denizi'nin en sevilen tatil adalarından biri olan Avşa'da plajlar çeşitli: geniş kumsallar, sığ ve sakin koylar, restoran ve kafelerle çevrili sahiller ve yalnızca kadınlara ayrılmış bir plaj. Ada küçük olduğu için hemen her koya merkezden en fazla yirmi dakikada ulaşılıyor; bu da sabah bir koyda, öğleden sonra bir başkasında yüzmeyi kolaylaştırıyor.</p>
  <figure class="not-prose mt-6">
    <img src="/img/hero.webp" alt="Avşa Adası'nda deniz kenarı, plaj ve yüzme alanı" width="1600" height="762" loading="lazy" class="w-full rounded-2xl object-cover" />
    <figcaption class="mt-2 text-center text-sm text-slate-500">Avşa Adası'nda plaj ve koy manzarası</figcaption>
  </figure>
  <p>Genel bir ayrım yapmak gerekirse doğu ve güneydoğu yakasındaki Altınkum, Karadut ve Kadınlar Plajı sığ ve sakin; Çınar Koyu adanın en geniş plajı; kuzeydeki Mavi Koy restoran ve kafelere yakın; adanın güney ucundaki Kumtur ise en sessiz bölge. Aşağıda her koyun karakterini, ulaşım süresini ve kimlere uygun olduğunu bulacaksın. Adanın geçmişini merak ediyorsan <a href="/avsa-adasi-tarihi-ve-plajlari/">Avşa Adası'nın tarihi ve plajları</a> yazısı, plaj dışındaki durakları arıyorsan <a href="/gezilecek-yerler/">Avşa gezilecek yerler</a> rehberi yardımcı olur.</p>

  <div class="not-prose my-6 grid grid-cols-2 gap-3 md:grid-cols-6">
    {galeri.map((g, i) => (
      <figure class={`overflow-hidden rounded-xl bg-slate-100 ${i === 0 ? "col-span-2 md:col-span-2" : i < 3 ? "md:col-span-2" : "md:col-span-3"} ${i >= 3 ? "" : ""}`}>
        <img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" />
        <figcaption class="px-3 py-2 text-xs text-slate-600">{g.cap}</figcaption>
      </figure>
    ))}
  </div>

  <h2 id="koylar">Plaj ve koy rehberi</h2>
  <p>Aşağıdaki liste, ulaşım süreleri merkezden (iskele çevresi) hesaplanarak hazırlandı. Süreler ve çalışma saatleri mevsime ve trafiğe göre değişebilir.</p>
  <div class="not-prose mt-5 grid gap-4 sm:grid-cols-2">
    {beaches.map((b) => (
      <section id={b.id} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="!mt-0 text-lg font-bold text-deniz-900">{b.name}</h3>
        <p class="!mt-1 text-sm font-semibold text-deniz-600">{b.where} · {b.time}</p>
        <p class="!mt-3 text-sm leading-relaxed">{b.text}</p>
      </section>
    ))}
  </div>

  <h2 id="aileler">Çocuklu aileler için plajlar</h2>
  <p>Çocukla plaj tatilinde en önemli ölçüt denizin sığ olması ve ihtiyaçlara yakınlık. Bu bakımdan <strong>Karadut Koyu</strong> öne çıkıyor: deniz sığ, giriş ücretsiz ve çay bahçeleri sayesinde yiyecek içecek bulmak kolay. <strong>Altınkum</strong>'da ise plaj işletmelerinin sunduğu şezlong, şemsiye ve yemek hizmetleri ailelerin işini kolaylaştırıyor. Kumtur gibi daha derin koylarda çocukları suda yalnız bırakmamak gerekiyor.</p>
  <h3>Aile tatili için küçük bir kontrol listesi</h3>
  <ul>
    <li>Şemsiye veya gölgelik, güneş kremi ve şapka.</li>
    <li>Yeterli su ve atıştırmalık, özellikle işletmesi olmayan plajlara giderken.</li>
    <li>Kaygan taşlı bölgeler için deniz ayakkabısı.</li>
    <li>Minibüs saatlerini öğrenmek; özellikle son dönüş saatini.</li>
  </ul>
  <p>Çocuk dostu konaklama arıyorsan ana sayfadaki <a href="/#konaklama">konaklama listesinde</a> "çocuk dostu" filtresini kullanabilirsin.</p>

  <h2 id="plaj-kulupleri">Plaj kulüpleri ve ücretsiz plajlar</h2>
  <p>Avşa'da plaj kulübü kültürü Altınkum ve Çınar Koyu'nda öne çıkıyor. Bu işletmelerde şezlong ve şemsiye ücretli; karşılığında içecek ve yemek servisi, tuvalet ve duş gibi olanaklar bulunuyor. Aynı koylarda ücretsiz halk plajı alanları da var. Bütçeni korumak istiyorsan havlunu, gölgeliğini ve yiyeceklerini alıp ücretsiz alana yerleşebilirsin. Karadut ve Kadınlar Plajı da ücretsiz seçenekler arasında.</p>
  <p>Ücretler işletmeye ve sezona göre değişiyor; bu sayfada sabit fiyat vermiyoruz. Gün içinde plajdaki işletmeden fiyat sormak en doğrusu.</p>

  <h2 id="sakin-koylar">Sakin ve kalabalıktan uzak koylar</h2>
  <p>Sessizlik arıyorsan <strong>Kumtur</strong> ve <strong>köy sahili</strong> en iyi seçenekler. Kumtur'da çevrede restoran ya da kafe yok; gün boyu kalacaksan yiyecek getirmek lazım. <strong>Manastır</strong> ve <strong>Beyazsaray</strong> yönü de merkezin kalabalığından uzak; ancak Beyazsaray'a iniş eğimli olduğu için ATV ile gitmek öneriliyor. Tekne kiralayarak merkezden kıyıyı takip edip yalnız bir koy bulmak da adanın sevilen yöntemlerinden.</p>

  <h2 id="ulasim">Plajlara nasıl gidilir?</h2>
  <p>Adada ulaşım ağırlıklı olarak minibüs, motosiklet, bisiklet ve ATV ile yapılıyor. Merkezden yaklaşık süreler: Mavi Koy 5 dk, Altınkum 10 dk, Çınar Koyu 10-15 dk, Kumtur 20 dk. Yiğitler Köyü minibüsleri belediye binasının önünden yarım saatte bir kalkıyor ve merkezden yaklaşık 5-6 dakika uzakta. Çınar Koyu hattı saatlik çalışıyor ve yaklaşık 20:00'ye kadar sefer yapıyor.</p>
  <p>Adaya nasıl geleceğini planlıyorsan <a href="/feribot-saatleri/">Avşa feribot saatleri</a> ve <a href="/bilet-fiyatlari/">feribot bilet fiyatları</a> sayfalarına bakabilirsin.</p>

  <h2 id="sezon">Ne zaman gidilir?</h2>
  <p>Plaj işletmelerinin çoğu yaz sezonunda açık; sezon açılış ve kapanış tarihleri işletmeye göre değişiyor. Deniz keyfi ve plaj olanakları için yaz ayları en uygunu. Sezon dışında birçok plaj işletmesi ve restoran kapalı olabilir, bu yüzden gitmeden önce aramak iyi olur. Akşam planı için <a href="/gece-hayati/">Avşa gece hayatı</a> rehberine de göz atabilirsin.</p>

  <h2 id="ipuclari">Plaj günü için ipuçları</h2>
  <ul>
    <li><strong>Erken git:</strong> Altınkum ve Çınar gibi popüler koylarda sabah saatleri daha rahat.</li>
    <li><strong>Nakit ve kart:</strong> Küçük işletmelerde kart çalışmayabilir; yanında bir miktar nakit bulundur.</li>
    <li><strong>Çöpünü geri al:</strong> İşletmesi olmayan plajlarda atıklarını kendin topla.</li>
    <li><strong>Dönüş saatini öğren:</strong> Minibüsün son seferini plajdan ayrılmadan sor.</li>
    <li><strong>Kadınlar Plajı:</strong> Yalnızca kadınlara ayrıldığı için saygılı davranmak gerekiyor.</li>
  </ul>

  <div id="konaklama"></div>
  <StayLinks items={yigitler} title="Altınkum ve Karadut'a yakın: Yiğitler Köyü'nde konaklama" />
  {merkezPlaj.length > 0 && <StayLinks items={merkezPlaj} title="Merkez sahiline yakın konaklama" />}
  {kadinlar.length > 0 && <StayLinks items={kadinlar} title="Kadınlar Plajı'na yakın konaklama" />}
  <p>Denize sıfır seçeneklerin tamamı için <a href="/#konaklama">Avşa otelleri, apartları ve pansiyonları</a> listemize, müstakil ev arıyorsan <a href="/kiralik-evler/">Avşa kiralık evler</a> sayfasına göz atabilirsin.</p>
</InfoLayout>
